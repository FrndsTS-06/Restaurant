# ========================================================
# RestaurantPro Frontend Environment Configuration (Vercel)
# ========================================================

# Base API URL:
# - For local development (proxied by Vite): /api
# - For production on Vercel connecting to Render API: https://restaurantpro-api.onrender.com/api
# - Or if using custom domains: https://api.yourdomain.com/api
VITE_API_URL=/api

# Public Razorpay Key ID (Safe to expose on client):
# In production, this must match the RAZORPAY_KEY_ID configured on Render backend.
VITE_RAZORPAY_KEY_ID=rzp_test_restaurantpro2026
