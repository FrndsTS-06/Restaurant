{
  "name": "restaurant-server",
  "version": "1.0.0",
  "description": "Backend API for Savoria Restaurant Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seedData.js",
    "smoke": "node --test tests/smoke.test.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js tests/auth.test.js tests/menu.test.js tests/order.test.js tests/reservation.test.js tests/admin.test.js tests/payment.test.js tests/business.test.js tests/supertest.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:menu": "node --test tests/menu.test.js",
    "test:order": "node --test tests/order.test.js",
    "test:reservation": "node --test tests/reservation.test.js",
    "test:admin": "node --test tests/admin.test.js",
    "test:payment": "node --test tests/payment.test.js",
    "test:business": "node --test tests/business.test.js",
    "test:supertest": "node --test tests/supertest.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.3.1"
  }
}
