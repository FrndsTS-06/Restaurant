# ==============================================================================
# RestaurantPro Server Environment Variables (Development & Production - Render)
# ==============================================================================

# Server Hosting & Runtime Mode
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/restaurantpro_prod?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/restaurantpro_db

# Client Addresses (CORS & Cross-Origin Cookies)
# Set CLIENT_URL to your Vercel deployment URL (e.g. https://restaurantpro.vercel.app)
# Use comma-separated list in ALLOWED_ORIGINS for multiple domains or custom domains
CLIENT_URL=https://restaurantpro.vercel.app
ALLOWED_ORIGINS=https://restaurantpro.vercel.app,http://localhost:5173

# Cross-Site Cookie Policy (Crucial for Vercel Frontend + Render Backend)
# For cross-domain hosting (different domains), set COOKIE_SAME_SITE=none
# In local dev same-domain, set COOKIE_SAME_SITE=lax
COOKIE_SAME_SITE=none

# Rate Limiting & Denial-of-Service Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Security & Cryptographic Tokens (Generate random 64-character strings for production)
JWT_SECRET=super_secret_production_jwt_key_restaurantpro_2026_at_least_64_characters
JWT_EXPIRES_IN=15m
JWT_ACCESS_SECRET=super_secret_production_jwt_access_token_key_restaurantpro_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_production_jwt_refresh_token_key_restaurantpro_2026
JWT_REFRESH_EXPIRES_IN=7d

# Razorpay Online Payment Gateway
# Obtain from Razorpay Dashboard -> Settings -> API Keys & Webhooks
RAZORPAY_KEY_ID=rzp_live_your_actual_key_id
RAZORPAY_KEY_SECRET=your_actual_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_actual_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# Cloudinary CDN Image Management
# Obtain from Cloudinary Dashboard -> Programmable Media -> API Keys
CLOUDINARY_CLOUD_NAME=your_actual_cloud_name
CLOUDINARY_API_KEY=your_actual_api_key
CLOUDINARY_API_SECRET=your_actual_api_secret

# Transactional Email Notification Provider (Nodemailer / SMTP)
# Set EMAIL_DEV_MODE=false to send live emails via SendGrid, Mailgun, Amazon SES, or Brevo
EMAIL_DEV_MODE=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_actual_smtp_api_key_or_password
EMAIL_FROM=SAVORIA Haute Cuisine <concierge@savoria.com>

# Observability, Error Monitoring & Logging
# Sentry DSN for automatic crash tracking & exception reporting
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
LOG_LEVEL=info
