# ==============================================================================
# RestaurantPro Full-Stack Platform Environment Configuration
# Target Stack: React (Vercel) + Express API (Render) + MongoDB Atlas + Cloudinary + Razorpay
# ==============================================================================

# Server Hosting & Runtime
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/restaurantpro_db

# Client Addresses (CORS & Cross-Origin Cookies)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,https://restaurantpro.vercel.app

# Cross-Site Cookie Policy (Set 'none' in production when frontend & backend are on different domains)
COOKIE_SAME_SITE=lax

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Security & Cryptographic Secrets
JWT_SECRET=restaurantpro_secure_jwt_secret_key_2026_dev_auth
JWT_ACCESS_SECRET=restaurantpro_secure_jwt_secret_key_2026_dev_auth
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=restaurantpro_secure_refresh_token_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# Client API Configuration
VITE_API_URL=/api
VITE_RAZORPAY_KEY_ID=rzp_test_restaurantpro2026

# Razorpay Payment Gateway (Test Sandbox / Production)
RAZORPAY_KEY_ID=rzp_test_restaurantpro2026
RAZORPAY_KEY_SECRET=restaurantpro_rzp_secret_key_sandbox
RAZORPAY_WEBHOOK_SECRET=restaurantpro_rzp_webhook_secret_sandbox_2026
RAZORPAY_CURRENCY=INR

# Cloudinary CDN Image Management
CLOUDINARY_CLOUD_NAME=restaurantpro-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvw_xyz

# Transactional Email Notification Provider (Nodemailer / SMTP)
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SAVORIA Haute Cuisine <concierge@savoria.com>

# Observability & Monitoring
SENTRY_DSN=
LOG_LEVEL=info
